# PRODUCTION build-time env vars for the Vercel frontend.
#
# Set these in the Vercel dashboard (Settings -> Environment Variables) or via
# `vercel env add`, with the URL of your DEPLOYED backend (Render/Railway/Fly),
# NOT localhost. They are baked into the bundle at build time on Vercel.
VITE_API_URL=https://your-backend.onrender.com/api
VITE_SOCKET_URL=https://your-backend.onrender.com
